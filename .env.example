# Copy to .env and fill in what you need. Every setting has a safe local default: with no .env at all the app
# runs offline from the extraction cache. On Cloud Run the same names are environment variables and secrets
# (deploy/02_deploy_app.sh, docs/DEPLOY_GCP.md).

# ---------------------------------------------------------------------------------------------------------
# Gemini model access: one switch, the extraction code is the same for both backends.
# ---------------------------------------------------------------------------------------------------------
# aistudio (default) = Google AI Studio API key below; vertex = Vertex AI in a Google Cloud project.
GEMINI_BACKEND=aistudio
# Google AI Studio API key (https://aistudio.google.com/apikey). Leave empty to work from the cache only.
GEMINI_API_KEY=
# Vertex AI (GEMINI_BACKEND=vertex): the project and location. Authentication is Application Default
# Credentials: on Cloud Run the service account, locally `gcloud auth application-default login`
# (the account needs roles/aiplatform.user). No API key is used. "global" or a region such as europe-west1,
# per the model availability table of Vertex AI.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Default model per the brief. Google currently limits gemini-2.5-flash to users who already used it;
# if the configured model is unavailable, extraction falls back automatically to the newest GA
# (non-preview) Flash model your key or project can access and logs which one it used.
# To pin a newer GA Flash model, change this single line (e.g. GEMINI_MODEL=gemini-3.8-flash).
GEMINI_MODEL=gemini-2.5-flash
# gemini (default) | fixture = offline ground-truth JSON from tests/fixtures (never calls the API;
# the UI labels it "fixture — not a Gemini output"). Used by the tests.
EXTRACTOR=gemini

# ---------------------------------------------------------------------------------------------------------
# Storage (defaults: folders under data/). On Cloud Run these point into the mounted Cloud Storage bucket.
# A relative path is taken from the project root.
# ---------------------------------------------------------------------------------------------------------
# Documents received by POST /intake/webhook (default data/invoices/inbound).
INBOUND_DIR=
# Extraction and draft cache, one JSON per file hash (default data/cache). Keep it: it avoids re-calling the API.
CACHE_DIR=
# KPI export, NDJSON per table (default data/export).
EXPORT_DIR=
# SQLite database (default sqlite:///<project>/data/velox.db). On Cloud Run: sqlite:////tmp/velox.db.
DATABASE_URL=

# ---------------------------------------------------------------------------------------------------------
# Basic auth in front of the whole app (one shared password; /health stays open). Empty password = off.
# The IMAP poller sends the same credentials to the webhook.
# ---------------------------------------------------------------------------------------------------------
APP_USERNAME=velox
APP_PASSWORD=

# ---------------------------------------------------------------------------------------------------------
# KPI export to BigQuery (optional). The NDJSON files are always written by `make export`; with BQ_EXPORT=1
# they are also loaded into BQ_PROJECT.BQ_DATASET (tables replaced on every export, also after each scenario
# run in the app). Needs `pip install -r requirements-gcp.txt` and the dataset (deploy/04_bigquery.sh).
# ---------------------------------------------------------------------------------------------------------
BQ_EXPORT=0
# Default: GOOGLE_CLOUD_PROJECT.
BQ_PROJECT=
BQ_DATASET=velox_p2p

# ---------------------------------------------------------------------------------------------------------
# Real intake: IMAP poller (python -m app.intake_imap --once, `make intake`). It posts every unseen message
# of the mailboxes to the webhook (PDF / UBL attachments, or the email body when there is no attachment).
# ---------------------------------------------------------------------------------------------------------
# Default http://127.0.0.1:8010/intake/webhook (make run). On GCP: https://<service-url>/intake/webhook
INTAKE_WEBHOOK_URL=
# Scenario the documents are registered in: tobe (default) | asis.
INTAKE_SCENARIO=tobe
# Mailbox 1: plays ap@velox.com. Gmail: imap.gmail.com, port 993, an app password (needs 2-step verification).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_CHANNEL=ap_mailbox
# Optional filters: only mail received on or after this date (YYYY-MM-DD), and only from these senders
# (comma-separated addresses or @domains; other senders are skipped and left unread).
IMAP_SINCE=
IMAP_ALLOWED_SENDERS=
# Mailbox 2 (optional): plays store.berlin01@velox.com.
IMAP2_HOST=
IMAP2_PORT=993
IMAP2_USER=
IMAP2_PASSWORD=
IMAP2_FOLDER=INBOX
IMAP2_CHANNEL=store_mailbox
IMAP2_SINCE=
IMAP2_ALLOWED_SENDERS=
