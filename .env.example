# Google AI Studio API key (https://aistudio.google.com/apikey). Leave empty to work from the cache only.
GEMINI_API_KEY=
# Default model per the brief. Google currently limits gemini-2.5-flash to users who already used it;
# if the configured model is unavailable, extraction falls back automatically to the newest GA
# (non-preview) Flash model your key can access and logs which one it used.
# To pin a newer GA Flash model, change this single line (e.g. GEMINI_MODEL=gemini-3.8-flash).
GEMINI_MODEL=gemini-2.5-flash
# gemini (default) | fixture = offline ground-truth JSON from tests/fixtures (never calls the API;
# the UI labels it "fixture — not a Gemini output"). Used by the tests.
EXTRACTOR=gemini
